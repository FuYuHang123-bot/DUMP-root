<Window x:Class="MemScope.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/memscope.ico" Title="MemScope · 设置"
        Width="600" MinHeight="520" MaxHeight="880" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="11.5"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,13">
            <StackPanel>
                <TextBlock Text="设置" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="默认配置面向「不被安全软件误判」，激进能力需要显式开启"
                           FontSize="10.5" Margin="0,3,0,0"
                           Foreground="{DynamicResource TextDimBrush}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14,18,16">
            <StackPanel>

                <!-- ===== 终止行为 ===== -->
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="终止行为" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkAdvanced" FontSize="11.5"
                                  Content="启用高级终止（直连系统调用 · 远程线程 · APC 投递）"
                                  Checked="ChkAdvanced_Changed" Unchecked="ChkAdvanced_Changed"/>

                        <TextBlock Margin="19,6,0,0" TextWrapping="Wrap" FontSize="10.5"
                                   Foreground="{DynamicResource TextFaintBrush}"
                                   Text="关闭时只用 Win32 TerminateProcess 结束进程，与 Process Explorer 的做法一致。"/>

                        <Border x:Name="WarningAdvanced" Visibility="Collapsed"
                                Margin="19,9,0,0" Padding="10,8" CornerRadius="4"
                                Background="{DynamicResource DangerSoftBrush}">
                            <TextBlock TextWrapping="Wrap" FontSize="10.5" LineHeight="16"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Text="开启后程序会解析系统调用号并准备一小段可执行内存，部分安全软件会因此提高关注度。仅在标准终止确实结束不了目标时才开启。"/>
                        </Border>

                        <TextBlock x:Name="LblSyscallStatus" Margin="19,9,0,0" FontSize="10.5"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}"/>
                    </StackPanel>
                </Border>

                <!-- ===== 内存提取 ===== -->
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="内存提取" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkFreeze" FontSize="11.5"
                                  Content="提取前冻结目标进程（拿到同一时刻的一致快照）"/>

                        <TextBlock Text="输出目录" Margin="0,13,0,5" FontSize="10.5"
                                   Foreground="{DynamicResource TextDimBrush}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtOutputDir" Style="{StaticResource Input}"/>
                            <Button Grid.Column="1" Content="浏览…" Width="70" Margin="8,0,0,0"
                                    Style="{StaticResource BtnGhost}" Click="BtnBrowse_Click"/>
                        </Grid>

                        <TextBlock Text="快照 CSV/JSON、提取出的模块与其 .meta.json 都会写到这里。"
                                   Margin="0,6,0,0" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFaintBrush}"/>
                    </StackPanel>
                </Border>

                <!-- ===== 外观 ===== -->
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkDark" Content="深色主题" FontSize="11.5"
                                  Checked="ChkDark_Changed" Unchecked="ChkDark_Changed"/>
                    </StackPanel>
                </Border>

                <!-- ===== 关于 ===== -->
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="关于" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="LblAbout" FontSize="10.5" LineHeight="17" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextDimBrush}"/>
                        <TextBlock x:Name="LblSettingsPath" Margin="0,7,0,0" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFaintBrush}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底栏 -->
        <Border Grid.Row="2" Background="{DynamicResource ToolbarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,11">
            <Grid>
                <Button Content="恢复默认" Style="{StaticResource BtnGhost}" Width="88"
                        HorizontalAlignment="Left" Click="BtnReset_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Width="76" Style="{StaticResource BtnGhost}" IsCancel="True"/>
                    <Button Content="保存" Width="86" Margin="8,0,0,0" Style="{StaticResource BtnPrimary}"
                            Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
