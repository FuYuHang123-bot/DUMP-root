<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MemScope</AssemblyName>
    <ApplicationIcon>Assets\memscope.ico</ApplicationIcon>
    <RootNamespace>MemScope</RootNamespace>
    <StartupObject>MemScope.Program</StartupObject>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <AssemblyTitle>MemScope 内存与文件实时观测台</AssemblyTitle>
    <Product>MemScope 内存与文件实时观测台</Product>
    <Company>MemScope</Company>
    <Description>进程内存与文件句柄实时观测、模块二进制提取工具</Description>
    <Copyright>Copyright © 2026 MemScope</Copyright>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\memscope.ico" />
  </ItemGroup>

  <!--
    高级构建（直连系统调用 + 远程线程/APC）默认不参与编译。
    要产出完整功能版：dotnet build -c Release -p:EnableAdvanced=true
    对外发布与 MSI 一律使用标准构建，二进制里不含调用桩、注入导入与可执行内存分配。
  -->
  <PropertyGroup Condition="'$(EnableAdvanced)' == 'true'">
    <DefineConstants>$(DefineConstants);MEMSCOPE_ADVANCED</DefineConstants>
  </PropertyGroup>

</Project>
