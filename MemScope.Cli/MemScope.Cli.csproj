<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>memscope-cli</AssemblyName>
    <RootNamespace>MemScopeCli</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../MemScope/AppSettings.cs" />
    <Compile Include="../MemScope/Core/*.cs" />
    <Compile Include="../MemScope/Interop/*.cs" />
    <Compile Include="../MemScope/GlobalUsings.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Bench.cs" />
  </ItemGroup>

</Project>
